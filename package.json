{
  "name": "autopen-v2",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:ci": "biome ci --error-on-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "turbo": "2.10.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
