# Lakaut integration. Copy to .env — gitignored — and fill from the integrator
# dashboard at https://web-preprod.lakautac.com.ar/dashboard/integrators.
#
# Nothing in packages/ reads these yet; they are consumed by the adapter and by
# whatever app creates sessions. Values below are preproduction. Development and
# preproduction share only the npm registry: API keys, integrator id, sessions,
# URLs, origins and webhook secrets are all per-environment and must never be
# copied between them.
#
# [Documented: docs/vendor/lakaut/sdk-integracion__credenciales.md]

# The canonical UUID under "Empresa / contrato", not the readable slug
# ("lucerosa"). The slug is a label and does not substitute for it — anything
# wired to a slug breaks. Not a secret, but environment-bound.
LAKAUT_INTEGRATOR_ID=

# Authenticates the backend against Lakaut: create, read, complete and cancel
# sessions. Sent as X-API-Key alongside X-Integrator-Id, always together.
# Backend only. If it reaches a browser bundle, an API response or a client log,
# rotate it. The SDK rejects it by name among renderer inputs.
LAKAUT_API_KEY=

# Signs inbound webhook events. Verification runs constructWebhookEvent over the
# raw body — parsing and re-serialising breaks the HMAC.
#
# Blank is the correct value until there is a deployed endpoint. The secret is
# issued against a saved URL, and that URL only becomes active once it answers a
# signed challenge: https on port 443, globally routable IPs only, POST with no
# redirects, under five seconds. Loopback, private ranges and CGNAT are refused,
# so a tunnel is the development answer, not localhost. Until a destination is
# configured Lakaut attempts no delivery at all, so an unset value drops nothing.
LAKAUT_WEBHOOK_SECRET=

LAKAUT_AUTH_BASE_URL=https://auth-preprod.lakautac.com.ar

# The SDK's name for preproduction. "local" is not part of the webhook contract.
LAKAUT_ENVIRONMENT=sandbox

# Sent per session as a concrete origin and validated against the declaration in
# the dashboard. A declared wildcard can never occupy this field: the Hosted UI
# talks to the page over postMessage, which requires an exact target origin. An
# undeclared origin fails closed with 403 FORBIDDEN_ORIGIN.
LAKAUT_ALLOWED_ORIGIN=https://dev.lucerolabs.xyz

# The Hosted UI's origin, allow-listed in the signing page's Content-Security-
# Policy (frame-src) and Permissions-Policy (camera, microphone). Per
# environment and given at onboarding, never derived from LAKAUT_ENVIRONMENT.
# [Documented: docs/vendor/lakaut/sdk-integracion__seguridad.md, "Content Security Policy"]
LAKAUT_HOSTED_UI_ORIGIN=https://sdk-preprod.lakautac.com.ar

# Read-only access to the private npm registry, for development and CI only —
# not a runtime credential. Read from .npmrc, so it must be exported into the
# environment before pnpm runs rather than loaded by the application.
LAKAUT_NPM_AUTH=

# --- The demo's own variables. Read by apps/signing-demo/src/env.ts, like the
# --- ones above; nothing in packages/ reads any of them.

# The port the demo listens on. Railway injects one; unset, 3000.
PORT=

# Where verified signed copies are archived, as <documentId>.pdf beside a
# .json manifest. Unset, the app's own apps/signing-demo/evidence/. On Railway
# a mounted volume — a directory inside the container is lost on every deploy,
# and a copy the service cannot produce is a signed document it cannot prove.
EVIDENCE_DIR=

# The one key a product presents, as `Authorization: Bearer <key>`, on the
# instrument and eligibility routes. At least 32 characters; generate it with
#   openssl rand -base64 32
# A backend secret: a product that uses it from a browser has leaked it. Never
# logged — a wrong key gets a bare 401 and a log line naming only the route.
AUTOPEN_API_KEY=

# Optional. When set, GET /health opens a TCP connection to its host and port
# and reports reachable or unreachable; nothing else reads it yet, no client
# connects, no SQL runs. It carries the password, so no part of it is ever
# logged or returned.
DATABASE_URL=
